<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="monta_pickup_widget_inject" inherit_id="website_sale.checkout" name="Monta Delivery Options &amp; Pickup Point Injection">
        <xpath expr="//t[@t-call='website_sale.billing_address_row']" position="before">
            <t t-if="website_sale_order and 'monta_shipper_code' in website_sale_order._fields">

                <!-- ══ Delivery Speed ══ -->
                <div class="monta-section monta-delivery-speed-container mt-4 mb-4">
                    <p class="monta-section-title">Choose your delivery speed</p>
                    <div class="monta-option-list">

                        <!-- Standard 2-day -->
                        <div class="monta-option-row"
                             t-att-class="'monta-option-row--active border-bottom' if (website_sale_order.monta_delivery_type or 'two_day') in ('two_day', 'standard') and not website_sale_order.monta_shipper_code else 'border-bottom'"
                             data-delivery="two_day">
                            <input type="radio" name="monta_delivery_speed" id="delivery_two_day" value="two_day"
                                   t-att-checked="'checked' if (website_sale_order.monta_delivery_type or 'two_day') in ('two_day', 'standard') and not website_sale_order.monta_shipper_code else None"
                                   class="monta-radio monta-delivery-radio"/>
                            <div class="monta-option-body">
                                <div class="monta-option-header">
                                    <label class="monta-option-name" for="delivery_two_day">
                                        Standard: 2-day delivery
                                        <span class="monta-info-badge" title="Delivered within 2 business days at no extra cost">i</span>
                                    </label>
                                    <span class="monta-option-price">€ 0.00</span>
                                </div>
                                <div class="monta-option-desc">Delivered within 2 business days</div>
                            </div>
                        </div>

                        <!-- Priority Next Day -->
                        <div class="monta-option-row"
                             t-att-class="'monta-option-row--active' if website_sale_order.monta_delivery_type == 'next_day' and not website_sale_order.monta_shipper_code else ''"
                             data-delivery="next_day">
                            <input type="radio" name="monta_delivery_speed" id="delivery_next_day" value="next_day"
                                   t-att-checked="'checked' if website_sale_order.monta_delivery_type == 'next_day' and not website_sale_order.monta_shipper_code else None"
                                   class="monta-radio monta-delivery-radio"/>
                            <div class="monta-option-body">
                                <div class="monta-option-header">
                                    <label class="monta-option-name" for="delivery_next_day">
                                        Priority: Next day delivery
                                        <span class="monta-info-badge" title="Order before cut-off time for next business day delivery">i</span>
                                    </label>
                                    <span class="monta-option-price">+ € 1.00</span>
                                </div>
                                <div class="monta-option-desc">Next business day — surcharge applies for next day delivery</div>
                            </div>
                        </div>

                    </div>
                </div>

                <!-- ══ Pickup Point ══ -->
                <div class="monta-section monta-pickup-container mt-2 mb-4">
                    <div class="monta-pickup-toggle-row">
                        <input type="checkbox" class="monta-pickup-checkbox" id="monta_use_pickup" name="monta_use_pickup"
                               t-att-checked="'checked' if website_sale_order.monta_shipper_code else None"/>
                        <label for="monta_use_pickup" class="monta-pickup-toggle-label">
                            Or deliver to a pickup point
                        </label>
                    </div>

                    <div id="monta-pickup-box" class="monta-pickup-box" t-att-class="'show' if website_sale_order.monta_shipper_code else ''">
                        <div class="monta-pickup-hint">Search pickup points near your address:</div>
                        <div class="row g-2 mb-3">
                            <div class="col-md-5">
                                <input type="text" id="monta_pickup_street" class="form-control form-control-sm" placeholder="Street name"
                                       t-att-value="website_sale_order.partner_shipping_id.street or website_sale_order.partner_id.street or ''"/>
                            </div>
                            <div class="col-md-3">
                                <input type="text" id="monta_pickup_house" class="form-control form-control-sm" placeholder="House no."
                                       t-att-value="website_sale_order.partner_shipping_id.street2 or website_sale_order.partner_id.street2 or ''"/>
                            </div>
                            <div class="col-md-4">
                                <input type="text" id="monta_pickup_zip" class="form-control form-control-sm" placeholder="Zip code"
                                       t-att-value="website_sale_order.partner_shipping_id.zip or website_sale_order.partner_id.zip or ''"/>
                            </div>
                            <div class="col-md-5">
                                <input type="text" id="monta_pickup_city" class="form-control form-control-sm" placeholder="City"
                                       t-att-value="website_sale_order.partner_shipping_id.city or website_sale_order.partner_id.city or ''"/>
                            </div>
                            <div class="col-md-4">
                                <select id="monta_pickup_country" class="form-select form-select-sm">
                                    <option value="NL" t-att-selected="'selected' if (website_sale_order.partner_shipping_id.country_id.code or website_sale_order.partner_id.country_id.code or 'NL') == 'NL' else None">Netherlands</option>
                                    <option value="BE" t-att-selected="'selected' if (website_sale_order.partner_shipping_id.country_id.code or website_sale_order.partner_id.country_id.code) == 'BE' else None">Belgium</option>
                                    <option value="DE" t-att-selected="'selected' if (website_sale_order.partner_shipping_id.country_id.code or website_sale_order.partner_id.country_id.code) == 'DE' else None">Germany</option>
                                    <option value="GB" t-att-selected="'selected' if (website_sale_order.partner_shipping_id.country_id.code or website_sale_order.partner_id.country_id.code) == 'GB' else None">United Kingdom</option>
                                </select>
                            </div>
                            <div class="col-md-3">
                                <button type="button" id="btn_search_monta_pickup" class="btn btn-sm w-100 monta-search-btn">
                                    Search
                                </button>
                            </div>
                        </div>

                        <div id="monta_pickup_loading" class="text-center d-none my-3">
                            <div class="spinner-border spinner-border-sm text-secondary" role="status">
                                <span class="visually-hidden">Loading...</span>
                            </div>
                        </div>
                        <div id="monta_pickup_error" class="alert alert-danger d-none py-2 px-3 small" role="alert"></div>
                        <div id="monta_pickup_results" class="monta-pickup-list d-flex flex-column gap-2" style="max-height: 380px; overflow-y: auto;"></div>
                    </div>
                </div>

            </t>
        </xpath>
    </template>
</odoo>
