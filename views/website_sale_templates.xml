<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="monta_pickup_widget_inject" inherit_id="website_sale.checkout" name="Monta Delivery Options &amp; Pickup Point Injection">
        <xpath expr="//t[@t-call='website_sale.billing_address_row']" position="before">
            <t t-if="website_sale_order and 'monta_shipper_code' in website_sale_order._fields">
                <!-- Section 1: Delivery Speed Options -->
                <div class="monta-delivery-speed-container mt-3 mb-3 p-3 border rounded bg-white shadow-sm">
                    <label for="monta_delivery_speed_select" class="fw-bold mb-2 d-flex align-items-center gap-2" style="color: #E5007D; font-size: 1rem;">
                        <i class="fa fa-truck"/> Select Delivery Speed:
                    </label>
                    <select id="monta_delivery_speed_select" name="monta_delivery_speed_select" class="form-select border-secondary form-select-md fw-bold">
                        <option value="two_day" t-att-selected="'selected' if (website_sale_order.monta_delivery_type or 'two_day') in ('two_day', 'standard') and not website_sale_order.monta_shipper_code else None">
                            Standard: 2-day delivery
                        </option>
                        <option value="next_day" t-att-selected="'selected' if website_sale_order.monta_delivery_type == 'next_day' and not website_sale_order.monta_shipper_code else None">
                            priority: Next day
                        </option>
                    </select>
                    <div class="mt-2 text-muted small">
                        <i class="fa fa-check-circle text-success me-1"/> Active Selection: 
                        <span class="fw-bold text-dark" t-out="'Standard: 2-day delivery' if (website_sale_order.monta_delivery_type or 'two_day') in ('two_day', 'standard') else 'priority: Next day'"/>
                    </div>
                </div>

                <!-- Section 3: Choose your shipping packaging -->
                <div class="monta-packaging-container mt-3 mb-3">
                    <h5 class="fw-bold mb-2 text-uppercase" style="color: #212529; font-size: 1.1rem; letter-spacing: 0.5px;">Choose your shipping packaging</h5>
                    <div class="border rounded bg-white shadow-sm overflow-hidden monta-packaging-list">
                        <!-- Option 1: Deposit packaging -->
                        <div class="p-3 border-bottom d-flex align-items-start gap-3 monta-packaging-item cursor-pointer" 
                             t-att-class="'active' if (website_sale_order.monta_packaging_type or 'deposit') == 'deposit' else ''"
                             data-packaging="deposit">
                            <div class="form-check m-0 p-0 d-flex align-items-center">
                                <input type="radio" name="monta_packaging_type" id="pkg_deposit" value="deposit" 
                                       t-att-checked="'checked' if (website_sale_order.monta_packaging_type or 'deposit') == 'deposit' else None"
                                       class="form-check-input monta-packaging-radio" style="margin: 0; cursor: pointer;"/>
                            </div>
                            <div class="flex-grow-1" style="cursor: pointer;">
                                <div class="d-flex justify-content-between align-items-center">
                                    <label class="fw-bold m-0 p-0 text-dark" for="pkg_deposit" style="cursor: pointer;">
                                        Deposit packaging <span class="monta-info-circle ms-1" style="display:inline-flex; align-items:center; justify-content:center; width:16px; height:16px; border-radius:50%; border: 1px solid #007bff; color:#007bff; font-size:10px; font-weight:bold; font-style:normal; line-height:1; vertical-align:middle; cursor:pointer;" title="Your deposit is returned when packaging is collected">i</span>
                                    </label>
                                    <span class="fw-bold text-dark">€ 0.00</span>
                                </div>
                                <div class="text-muted small mt-1">Your deposit is returned when packaging is collected</div>
                            </div>
                        </div>

                        <!-- Option 2: Single-use packaging -->
                        <div class="p-3 d-flex align-items-start gap-3 monta-packaging-item cursor-pointer" 
                             t-att-class="'active' if website_sale_order.monta_packaging_type == 'single_use' else ''"
                             data-packaging="single_use">
                            <div class="form-check m-0 p-0 d-flex align-items-center">
                                <input type="radio" name="monta_packaging_type" id="pkg_single_use" value="single_use" 
                                       t-att-checked="'checked' if website_sale_order.monta_packaging_type == 'single_use' else None"
                                       class="form-check-input monta-packaging-radio" style="margin: 0; cursor: pointer;"/>
                            </div>
                            <div class="flex-grow-1" style="cursor: pointer;">
                                <div class="d-flex justify-content-between align-items-center">
                                    <label class="fw-bold m-0 p-0 text-dark" for="pkg_single_use" style="cursor: pointer;">
                                        Single-use packaging
                                    </label>
                                    <span class="fw-bold text-dark">+ € 0.25</span>
                                </div>
                                <div class="text-muted small mt-1">Standard delivery packaging</div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Section 2: Delivery Point / Pickup Point -->
                <div class="monta-pickup-container mt-3 mb-4 p-3 border rounded bg-white shadow-sm">
                    <div class="form-check monta-pickup-selector">
                        <input type="checkbox" class="form-check-input" id="monta_use_pickup" name="monta_use_pickup" t-att-checked="'checked' if website_sale_order.monta_shipper_code else None"/>
                        <label class="form-check-label fw-bold text-uppercase" for="monta_use_pickup" style="color: #E5007D; cursor: pointer; letter-spacing: 0.5px;">
                            <i class="fa fa-map-marker me-1"/> Or send to a delivery point
                        </label>
                    </div>
                    
                    <div id="monta-pickup-box" class="collapse mt-3 pt-3 border-top" t-att-class="'show' if website_sale_order.monta_shipper_code else ''">
                        <div class="text-muted small mb-2"><i class="fa fa-info-circle me-1"/> Search pickup points near your address:</div>
                        <div class="row g-2 mb-3">
                            <div class="col-md-5">
                                <input type="text" id="monta_pickup_street" class="form-control form-control-sm border-secondary" placeholder="Street Name" t-att-value="website_sale_order.partner_shipping_id.street or website_sale_order.partner_id.street or ''"/>
                            </div>
                            <div class="col-md-3">
                                <input type="text" id="monta_pickup_house" class="form-control form-control-sm border-secondary" placeholder="House #" t-att-value="website_sale_order.partner_shipping_id.street2 or website_sale_order.partner_id.street2 or ''"/>
                            </div>
                            <div class="col-md-4">
                                <input type="text" id="monta_pickup_zip" class="form-control form-control-sm border-secondary" placeholder="Zip Code" t-att-value="website_sale_order.partner_shipping_id.zip or website_sale_order.partner_id.zip or ''"/>
                            </div>
                            <div class="col-md-5">
                                <input type="text" id="monta_pickup_city" class="form-control form-control-sm border-secondary" placeholder="City" t-att-value="website_sale_order.partner_shipping_id.city or website_sale_order.partner_id.city or ''"/>
                            </div>
                            <div class="col-md-4">
                                <select id="monta_pickup_country" class="form-select form-select-sm border-secondary">
                                    <option value="NL" t-att-selected="'selected' if (website_sale_order.partner_shipping_id.country_id.code or website_sale_order.partner_id.country_id.code or 'NL') == 'NL' else None">Netherlands</option>
                                    <option value="BE" t-att-selected="'selected' if (website_sale_order.partner_shipping_id.country_id.code or website_sale_order.partner_id.country_id.code) == 'BE' else None">Belgium</option>
                                    <option value="DE" t-att-selected="'selected' if (website_sale_order.partner_shipping_id.country_id.code or website_sale_order.partner_id.country_id.code) == 'DE' else None">Germany</option>
                                    <option value="GB" t-att-selected="'selected' if (website_sale_order.partner_shipping_id.country_id.code or website_sale_order.partner_id.country_id.code) == 'GB' else None">United Kingdom</option>
                                </select>
                            </div>
                            <div class="col-md-3">
                                <button type="button" id="btn_search_monta_pickup" class="btn btn-sm w-100 text-white fw-bold" style="background-color: #E5007D; border-color: #E5007D;">
                                    <i class="fa fa-search me-1"/> Search
                                </button>
                            </div>
                        </div>
                        
                        <div id="monta_pickup_loading" class="text-center d-none my-4">
                            <div class="spinner-border spinner-border-sm" role="status" style="color: #E5007D;">
                                <span class="visually-hidden">Loading...</span>
                            </div>
                        </div>
                        
                        <div id="monta_pickup_error" class="alert alert-danger d-none py-2 px-3 small" role="alert">
                        </div>
                        
                        <div id="monta_pickup_results" class="monta-pickup-list d-flex flex-column gap-2" style="max-height: 380px; overflow-y: auto;">
                            <!-- Dynamically loaded pickup point cards -->
                        </div>
                    </div>
                </div>
            </t>
        </xpath>
    </template>
</odoo>
