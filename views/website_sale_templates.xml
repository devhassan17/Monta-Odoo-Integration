<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="monta_pickup_widget_inject" inherit_id="website_sale.payment" name="Monta Delivery Options &amp; Pickup Point Injection">
        <!-- Target the delivery method block to position it under address and above delivery methods. -->
        <!-- Fallback to oe_cart if delivery_method is not in this view -->
        <xpath expr="//*[@id='delivery_method'] | //*[@id='o_payment_delivery_methods']" position="before">
            <t t-if="website_sale_order and 'monta_shipper_code' in website_sale_order._fields and website_sale_order.is_monta_delivery_allowed">

                <div class="monta-delivery-speed-container mt-4 mb-4">
                    
                    <!-- Delivery Speed Section -->
                    <h3 class="o_page_header mt8 mb-3" style="text-transform: uppercase; font-weight: bold; font-size: 1.1rem; color: #212529;">Choose your delivery speed</h3>
                    <div class="border rounded mb-4" style="background-color: transparent;">
                        <!-- Standard 2-day -->
                        <div class="p-3 d-flex align-items-center gap-3 monta-delivery-card border-bottom"
                             t-att-class="'p-3 d-flex align-items-center gap-3 monta-delivery-card border-bottom monta-delivery-card--active' if (website_sale_order.monta_delivery_type or 'two_day') in ('two_day', 'standard') else 'p-3 d-flex align-items-center gap-3 monta-delivery-card border-bottom'"
                             data-delivery="two_day" style="cursor: pointer;">
                            <input type="radio" name="monta_delivery_speed" id="delivery_two_day" value="two_day"
                                   t-att-checked="'checked' if (website_sale_order.monta_delivery_type or 'two_day') in ('two_day', 'standard') else None"
                                   class="monta-radio monta-delivery-radio" style="flex-shrink: 0;"/>
                            <div class="flex-grow-1">
                                <div class="d-flex justify-content-between align-items-center">
                                    <label class="mb-0" for="delivery_two_day" style="cursor: pointer; font-weight: 500; font-size: 1rem; color: #212529;">
                                        Standard: 2-day delivery
                                        <span class="monta-info-badge ms-1" title="Delivered within 2 business days at no extra cost">i</span>
                                    </label>
                                    <span class="fw-bold ms-3 text-nowrap" style="color: #212529;">€ 0.00</span>
                                </div>
                                <div class="text-muted mt-1" style="font-size: 0.85rem;">Delivered within 2 business days</div>
                            </div>
                        </div>

                        <!-- Priority Next Day -->
                        <div class="p-3 d-flex align-items-center gap-3 monta-delivery-card"
                             t-att-class="'p-3 d-flex align-items-center gap-3 monta-delivery-card monta-delivery-card--active' if website_sale_order.monta_delivery_type == 'next_day' else 'p-3 d-flex align-items-center gap-3 monta-delivery-card'"
                             data-delivery="next_day" style="cursor: pointer;">
                            <input type="radio" name="monta_delivery_speed" id="delivery_next_day" value="next_day"
                                   t-att-checked="'checked' if website_sale_order.monta_delivery_type == 'next_day' else None"
                                   class="monta-radio monta-delivery-radio" style="flex-shrink: 0;"/>
                            <div class="flex-grow-1">
                                <div class="d-flex justify-content-between align-items-center">
                                    <label class="mb-0" for="delivery_next_day" style="cursor: pointer; font-weight: 500; font-size: 1rem; color: #212529;">
                                        Priority: Next day delivery
                                        <span class="monta-info-badge ms-1" title="Order before cut-off time for next business day delivery">i</span>
                                    </label>
                                    <span class="fw-bold ms-3 text-nowrap" style="color: #212529;">+ € 1.00</span>
                                </div>
                                <div class="text-muted mt-1" style="font-size: 0.85rem;">Next business day — surcharge applies for next day delivery</div>
                            </div>
                        </div>
                    </div>

                    <!-- Pickup Point Section -->
                    <h3 class="o_page_header mt8 mb-3" style="text-transform: uppercase; font-weight: bold; font-size: 1.1rem; color: #212529;">Deliver to a pickup point</h3>
                    <div class="border rounded" style="background-color: transparent;">
                        <div class="monta-pickup-container">
                            <div class="p-3 d-flex align-items-center gap-3 monta-delivery-card"
                                 t-att-class="'p-3 d-flex align-items-center gap-3 monta-delivery-card monta-delivery-card--active' if website_sale_order.monta_shipper_code else 'p-3 d-flex align-items-center gap-3 monta-delivery-card'"
                                 style="cursor: pointer;">
                                <input type="checkbox" class="monta-checkbox monta-pickup-checkbox" id="monta_use_pickup" name="monta_use_pickup"
                                       t-att-checked="'checked' if website_sale_order.monta_shipper_code else None"
                                       style="flex-shrink: 0;"/>
                                <div class="flex-grow-1">
                                    <div class="d-flex justify-content-between align-items-center">
                                        <label for="monta_use_pickup" class="mb-0"
                                               style="cursor: pointer; font-weight: 500; font-size: 1rem; color: #212529;">
                                            Select a pickup point
                                        </label>
                                    </div>
                                    <div class="text-muted mt-1" style="font-size: 0.85rem;">Select a convenient pickup location near you</div>
                                </div>
                            </div>

                            <div id="monta-pickup-box" class="monta-pickup-box border-top" t-att-class="'show border-top' if website_sale_order.monta_shipper_code else 'border-top'">
                                <div class="p-3">
                                    <div class="text-muted mb-2" style="font-size: 0.85rem;">Search pickup points near your address:</div>
                                    <!-- Search Form -->
                                    <div class="row g-2 mb-3">
                                        <div class="col-md-5">
                                            <input type="text" id="monta_pickup_street" class="form-control form-control-sm" placeholder="Street name"
                                                   t-att-value="website_sale_order.partner_shipping_id.street or website_sale_order.partner_id.street or ''"/>
                                        </div>
                                        <div class="col-md-3">
                                            <input type="text" id="monta_pickup_house" class="form-control form-control-sm" placeholder="House no."
                                                   t-att-value="website_sale_order.partner_shipping_id.street2 or website_sale_order.partner_id.street2 or ''"/>
                                        </div>
                                        <div class="col-md-4">
                                            <input type="text" id="monta_pickup_zip" class="form-control form-control-sm" placeholder="Zip code"
                                                   t-att-value="website_sale_order.partner_shipping_id.zip or website_sale_order.partner_id.zip or ''"/>
                                        </div>
                                        <div class="col-md-5">
                                            <input type="text" id="monta_pickup_city" class="form-control form-control-sm" placeholder="City"
                                                   t-att-value="website_sale_order.partner_shipping_id.city or website_sale_order.partner_id.city or ''"/>
                                        </div>
                                        <div class="col-md-4">
                                            <select id="monta_pickup_country" class="form-select form-select-sm">
                                                <option value="NL" t-att-selected="'selected' if (website_sale_order.partner_shipping_id.country_id.code or website_sale_order.partner_id.country_id.code or 'NL') == 'NL' else None">Netherlands</option>
                                                <option value="BE" t-att-selected="'selected' if (website_sale_order.partner_shipping_id.country_id.code or website_sale_order.partner_id.country_id.code) == 'BE' else None">Belgium</option>
                                                <option value="DE" t-att-selected="'selected' if (website_sale_order.partner_shipping_id.country_id.code or website_sale_order.partner_id.country_id.code) == 'DE' else None">Germany</option>
                                                <option value="GB" t-att-selected="'selected' if (website_sale_order.partner_shipping_id.country_id.code or website_sale_order.partner_id.country_id.code) == 'GB' else None">United Kingdom</option>
                                            </select>
                                        </div>
                                        <div class="col-md-3">
                                            <button type="button" id="btn_search_monta_pickup" class="btn btn-sm w-100 text-white fw-bold"
                                                    style="background-color: #E5007D; border-color: #E5007D;">
                                                Search
                                            </button>
                                        </div>
                                    </div>

                                    <div id="monta_pickup_loading" class="text-center d-none my-3">
                                        <div class="spinner-border spinner-border-sm" role="status" style="color: #E5007D;">
                                            <span class="visually-hidden">Loading...</span>
                                        </div>
                                    </div>
                                    <div id="monta_pickup_error" class="alert alert-danger d-none py-2 px-3 small" role="alert"></div>
                                    <div id="monta_pickup_results" class="monta-pickup-list d-flex flex-column gap-2 mt-2" style="max-height: 380px; overflow-y: auto;"></div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

            </t>
        </xpath>
    </template>
</odoo>
